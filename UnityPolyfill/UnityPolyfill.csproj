<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
        <LangVersion>8</LangVersion>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <Authors>ParaParty</Authors>
        <Product>ParaParty Util Strings</Product>
        <PackageProjectUrl>https://pkg.para.party/ParaPartyUtil</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ParaParty/ParaPartyUtil/</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Description>ParaParty Util Strings</Description>

        <RootNamespace>Paraparty</RootNamespace>
        <AssemblyName>Paraparty.UnityPolyfill</AssemblyName>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Version>3.1.0</Version>
        <AssemblyVersion>3.1.0.0</AssemblyVersion>
        <FileVersion>3.1.0.0</FileVersion>

        <!-- Define compiler symbols based on target framework -->
        <DefineConstants Condition="'$(TargetFramework)' == 'netstandard2.0'">NETSTANDARD20</DefineConstants>
        <DefineConstants Condition="'$(TargetFramework)' == 'netstandard2.1'">NETSTANDARD21</DefineConstants>

    </PropertyGroup>

</Project>
